---
permalink: "api/search.json"
eleventyExcludeFromCollections: true
---
{#- Search index. Values are JSON-encoded with `dump`, not HTML-escaped: this is
    a JSON API, and the client escapes for HTML itself when rendering a result.

    Entry order matters — search.js sorts by score with a stable sort, so ties
    fall back to this order. Broader pages come first: family → tier → variant.
-#}
{#- Ranking weights, added to the client's match score. Flagship lines outrank
    niche ones, and anything discontinued sinks below its current siblings. -#}
{%- set CATEGORY_WEIGHT = {
  "mac": 1.2, "iphone": 1.0, "ipad": 0.6, "watch": 0.5, "airpods": 0.4,
  "vision": 0.4, "homepod": 0.3, "apple-tv": 0.3, "display": 0
} -%}
{%- set DISCONTINUED_PENALTY = 0.8 -%}

{%- set results = [] -%}

{#- Chip family pages, e.g. /chips/m5/ -#}
{%- for gen in collections.generationPagesCollection -%}
  {%- set tierNames = [] -%}
  {%- for t in gen.tiers -%}{%- set _ = tierNames.push(t.name) -%}{%- endfor -%}
  {%- set _ = results.push({
    type: "family", id: gen.id, name: gen.name,
    detail: tierNames | join(", "),
    url: "/chips/" + (gen.id | lower) + "/"
  }) -%}
{%- endfor -%}

{#- Chip tier pages, e.g. /chips/m5/max/. Skipped only when a rank holds one
    chip that has no variant page of its own (N1, C1, S-series …) — for those
    the chip entry below already points at this very URL. -#}
{%- for rank in collections.rankPagesCollection -%}
  {%- set soleChipIsThisPage = rank.variants | length == 1 and (rank.variants[0] | chipVariant) == rank.variants[0] -%}
  {%- if not soleChipIsThisPage -%}
    {%- set _ = results.push({
      type: "tier", id: rank.id, name: rank.name,
      detail: rank.description if rank.description else (rank.variants | length + " variants"),
      url: "/chips/" + (rank.id | genId | lower) + "/" + (rank.id | tierSlug | lower) + "/"
    }) -%}
  {%- endif -%}
{%- endfor -%}

{#- Individual chips -#}
{%- for chip in collections.chipPagesCollection -%}
  {%- if chip.specs.cpu_cores and chip.specs.gpu_cores -%}
    {%- set detail = chip.specs.cpu_cores ~ "-core CPU / " ~ chip.specs.gpu_cores ~ "-core GPU" -%}
  {%- elif chip.specs.cpu_cores -%}
    {%- set detail = chip.specs.cpu_cores ~ "-core CPU" -%}
  {%- elif chip.rank and chip.rank.rankDescription -%}
    {%- set detail = chip.rank.rankDescription -%}
  {%- else -%}
    {%- set detail = chip.name -%}
  {%- endif -%}
  {%- set _ = results.push({
    type: "chip", id: chip.id, name: chip.name, detail: detail, url: chip.url
  }) -%}
{%- endfor -%}

{#- Series overview pages, e.g. /series/m/ -#}
{%- for s in collections.seriesCollection -%}
  {%- set _ = results.push({
    type: "series", id: s.id, name: s.name, detail: s.description,
    url: "/series/" + (s.id | lower) + "/"
  }) -%}
{%- endfor -%}

{#- Devices -#}
{%- for device in collections.devicePagesCollection -%}
  {%- set detail = device.categoryName -%}
  {%- if device.variants -%}
    {%- set detail = detail ~ " · " ~ (device.variants | length) ~ " chip" ~ ("s" if device.variants | length != 1 else "") -%}
  {%- endif -%}
  {%- set weight = CATEGORY_WEIGHT[device.categoryId] if CATEGORY_WEIGHT[device.categoryId] is defined else 0.3 -%}
  {%- if device.discontinued -%}{%- set weight = weight - DISCONTINUED_PENALTY -%}{%- endif -%}
  {%- set _ = results.push({
    type: "device", id: device.id, name: device.name, detail: detail,
    keywords: device.chipNames | join(" "),
    weight: weight | round(2),
    discontinued: device.discontinued,
    url: device.url
  }) -%}
{%- endfor -%}

{#- Standalone pages: comparisons, current lineups, gen-gains. The home page is
    deliberately excluded — it is not a destination worth searching for. -#}
{%- for p in collections.all -%}
  {%- set u = p.url -%}
  {%- if u == "/devices/" or u == "/chips/" or u.startsWith("/compare/") or u.startsWith("/current/") or u.startsWith("/gen-gains/") -%}
    {%- set _ = results.push({
      type: "page",
      id: u,
      name: p.data.title if p.data.title else "Apple Silicon Specs",
      detail: p.data.description if p.data.description else "",
      weight: 1.0 if u.startsWith("/current/") else 0.5,
      url: u
    }) -%}
  {%- endif -%}
{%- endfor -%}

{{ results | dump | safe }}
