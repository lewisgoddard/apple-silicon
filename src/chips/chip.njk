---
layout: base.njk
pagination:
  data: collections.chipVariantPagesCollection
  size: 1
  alias: chip
permalink: "chips/{{ chip.id | genId | lower }}/{{ chip.id | chipTier | lower }}/{{ chip.id | chipVariant }}/index.html"
eleventyComputed:
  title: "{{ chip.name }} ({{ chip.specs.cpu_cores }}c CPU / {{ chip.specs.gpu_cores }}c GPU)"
  description: "Technical specifications for the {{ chip.name }} with {{ chip.specs.cpu_cores }}-core CPU and {{ chip.specs.gpu_cores }}-core GPU."
  ogType: "product"
---

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ chip.name }} ({{ chip.specs.cpu_cores }}-core CPU / {{ chip.specs.gpu_cores }}-core GPU)",
  "brand": { "@type": "Brand", "name": "Apple" },
  "description": "{{ chip.name }} Apple Silicon chip with {{ chip.specs.cpu_cores }}-core CPU and {{ chip.specs.gpu_cores }}-core GPU.",
  "url": "{{ site.url }}/chips/{{ chip.id | genId | lower }}/{{ chip.id | chipTier | lower }}/{{ chip.id | chipVariant }}/",
  "category": "Processor",
  "additionalProperty": [
    {% set comma = false %}
    {% for group in chip.groupedSpecs %}
      {% for field in group.fields %}
        {% if field.value is not none and field.value is defined %}
          {% if comma %},{% endif %}
          {
            "@type": "PropertyValue",
            "propertyID": "{{ field.label }}",
            "name": "{{ field.label }}",
            "value": "{% if field.value is iterable and field.value is not string %}{{ field.value | join(', ') }}{% elif field.value == true %}Yes{% elif field.value == false %}No{% else %}{{ field.value }}{% endif %}"
          }
          {% set comma = true %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  ]
}
</script>
{% endblock %}

{% from "macros/device-carousel.njk" import deviceCarousel %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/spec-card.njk" import specCard %}

{{ breadcrumbs([
  { label: chip.rank.seriesId + " Series" if chip.rank else "Series", url: "/series/" + (chip.rank.seriesId | lower if chip.rank else "m") + "/" },
  { label: (chip.id | genId | upper) + " Family", url: "/chips/" + (chip.id | genId | lower) + "/" },
  { label: chip.rank.rankName if chip.rank else chip.name, url: "/chips/" + (chip.id | genId | lower) + "/" + (chip.id | chipTier | lower) + "/" },
  { label: chip.name + " " + chip.specs.cpu_cores + "c/" + chip.specs.gpu_cores + "c" }
]) }}

<h1>{{ chip.name }}</h1>
<p>{{ chip.specs.cpu_cores }}-core CPU / {{ chip.specs.gpu_cores }}-core GPU</p>

{{ specCard(chip) }}

{# Specs table (single chip, no comparison) #}
<div class="compare-table-wrapper">
<table class="compare-table">
  <thead>
    <tr>
      <th>Spec</th>
      <th>Value</th>
    </tr>
  </thead>
  <tbody>
    {% for group in chip.groupedSpecs %}
      {# Only show groups that have at least one non-null field #}
      {% set groupHasData = false %}
      {% for field in group.fields %}
        {% if field.value is not none and field.value is defined %}
          {% set groupHasData = true %}
        {% endif %}
      {% endfor %}
      {% if groupHasData %}
      <tr class="group-header">
        <td colspan="2"><strong>{{ group.name }}</strong></td>
      </tr>
      {% for field in group.fields %}
        {% if field.value is not none and field.value is defined %}
        <tr>
          <td>{{ field.label }}</td>
          <td>
            {% if field.value is iterable and field.value is not string %}
              {{ field.value | join(", ") }}
            {% elif field.value == true %}
              ✓
            {% elif field.value == false %}
              ✗
            {% else %}
              {{ field.value }}
            {% endif %}
          </td>
        </tr>
        {% endif %}
      {% endfor %}
      {% endif %}
    {% endfor %}
  </tbody>
</table>
</div>

{{ deviceCarousel(chip.devices) }}
