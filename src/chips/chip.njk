---
layout: base.njk
pagination:
  data: collections.chipPagesCollection
  size: 1
  alias: chip
permalink: "chips/{{ chip.id | genId | lower }}/{{ chip.id | chipTier | lower }}/{{ chip.id | chipVariant }}/index.html"
eleventyComputed:
  title: "{{ chip.name }} ({{ chip.specs.cpu_cores }}c CPU / {{ chip.specs.gpu_cores }}c GPU)"
  description: "Technical specifications for the {{ chip.name }} with {{ chip.specs.cpu_cores }}-core CPU and {{ chip.specs.gpu_cores }}-core GPU."
---

{% from "macros/device-carousel.njk" import deviceCarousel %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}

{{ breadcrumbs([
  { label: chip.rank.seriesId + " Series" if chip.rank else "Series", url: "/series/" + (chip.rank.seriesId | lower if chip.rank else "m") + "/" },
  { label: (chip.id | genId | upper) + " Family", url: "/chips/" + (chip.id | genId | lower) + "/" },
  { label: chip.rank.rankName if chip.rank else chip.name, url: "/chips/" + (chip.id | genId | lower) + "/" + (chip.id | chipTier | lower) + "/" },
  { label: chip.name + " " + chip.specs.cpu_cores + "c/" + chip.specs.gpu_cores + "c" }
]) }}

<h1>{{ chip.name }}</h1>
<p>{{ chip.specs.cpu_cores }}-core CPU / {{ chip.specs.gpu_cores }}-core GPU</p>

{# Specs table (single chip, no comparison) #}
<div class="compare-table-wrapper">
<table class="compare-table">
  <thead>
    <tr>
      <th>Spec</th>
      <th>Value</th>
    </tr>
  </thead>
  <tbody>
    {% for group in chip.groupedSpecs %}
      <tr class="group-header">
        <td colspan="2"><strong>{{ group.name }}</strong></td>
      </tr>
      {% for field in group.fields %}
        <tr>
          <td>{{ field.label }}</td>
          <td>
            {% if field.value is iterable and field.value is not string %}
              {{ field.value | join(", ") }}
            {% else %}
              {{ field.value }}
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    {% endfor %}
  </tbody>
</table>
</div>

{{ deviceCarousel(chip.devices) }}
