<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}{% if title %} · {% endif %}Apple Silicon Specs</title>
    {% if description %}
      <meta name="description" content="{{ description }}" />
    {% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {# Open Graph #}
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title if title else site.name }}" />
    <meta property="og:description" content="{{ description if description else site.description }}" />
    <meta property="og:type" content="{{ ogType if ogType else 'website' }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />

    {# Twitter card #}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ title if title else site.name }}" />
    <meta name="twitter:description" content="{{ description if description else site.description }}" />

    {% block jsonld %}{% endblock %}
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="nav-home">Apple Silicon Specs</a>
        <ul class="nav-links">
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Compare <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-2col">
              <span class="nav-dropdown-section">by Use Case</span>
              <a href="/compare/video-editing/" class="nav-hl-video">Video Editing</a>
              <a href="/compare/ml-ai/" class="nav-hl-mlai">ML / AI</a>
              <a href="/compare/gaming/" class="nav-hl-gaming">Gaming</a>
              <a href="/compare/custom/" class="nav-hl-custom">Custom</a>
              <span class="nav-dropdown-section">by Product</span>
              <a href="/current/macbooks/">Macbooks</a>
              <a href="/current/macs/">Macs</a>
              <a href="/current/iphones/">iPhones</a>
              <a href="/current/ipads/">iPads</a>
              <a href="/current/watches/">Watches</a>
              <a href="/current/airpods/">AirPods</a>
              <span class="nav-dropdown-section">by Generation</span>
              <a href="/gen-gains/m-series/">M-Series</a>
              <a href="/gen-gains/a-series/">A-Series</a>
            </div>
          </li>
          <li class="nav-collapse"><a href="/gen-gains/m-series/">M-Series</a></li>
          <li class="nav-collapse"><a href="/gen-gains/a-series/">A-Series</a></li>
          <li class="nav-divider" aria-hidden="true"></li>
          <li class="nav-collapse"><a href="/compare/video-editing/" class="nav-hl-video">Video Editing</a></li>
          <li class="nav-collapse"><a href="/compare/ml-ai/" class="nav-hl-mlai">ML / AI</a></li>
          <li class="nav-collapse"><a href="/compare/gaming/" class="nav-hl-gaming">Gaming</a></li>
          <li class="nav-collapse"><a href="/compare/custom/" class="nav-hl-custom">Custom</a></li>
          <li class="nav-divider" aria-hidden="true"></li>
          <li class="nav-collapse"><a href="/current/macbooks/">Macbooks</a></li>
          <li class="nav-collapse"><a href="/current/macs/">Macs</a></li>
          <li class="nav-collapse"><a href="/current/iphones/">iPhones</a></li>
          <li class="nav-collapse"><a href="/current/ipads/">iPads</a></li>
        </ul>
        <div class="search-wrapper">
          <input type="search" id="site-search" placeholder="Search chips & devices…  /" autocomplete="off" />
          <div id="search-results" class="search-results"></div>
        </div>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <nav class="footer-nav" aria-label="Site map">
        <div class="footer-col">
          <h2>Compare</h2>
          <ul>
            <li><a href="/compare/video-editing/" class="nav-hl-video">Video Editing</a></li>
            <li><a href="/compare/ml-ai/" class="nav-hl-mlai">ML / AI</a></li>
            <li><a href="/compare/gaming/" class="nav-hl-gaming">Gaming</a></li>
            <li><a href="/compare/custom/" class="nav-hl-custom">Custom Comparison</a></li>
          </ul>
          <h2>Generational Gains</h2>
          <ul>
            <li><a href="/gen-gains/m-series/">M-Series Generational Gains</a></li>
            <li><a href="/gen-gains/a-series/">A-Series Generational Gains</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2>Current Lineups</h2>
          <ul>
            <li><a href="/current/macbooks/">MacBooks</a></li>
            <li><a href="/current/macs/">Mac Desktops</a></li>
            <li><a href="/current/iphones/">iPhones</a></li>
            <li><a href="/current/ipads/">iPads</a></li>
            <li><a href="/current/watches/">Apple Watches</a></li>
            <li><a href="/current/airpods/">AirPods</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2><a href="/devices/">Devices by Product</a></h2>
          <ul>
            {% for cat in collections.devicesCollection %}
              <li><a href="/devices/{{ cat.id | lower }}/">{{ cat.name }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <h2><a href="/chips/">Chips by Series</a></h2>
          <ul>
            {# Fully alphabetical here — M and A are highlighted rather than hoisted #}
            {% for s in collections.seriesCollection | sort(false, false, "id") %}
              <li><a href="/series/{{ s.id | lower }}/"{% if s.id == "M" or s.id == "A" %} class="nav-hl-custom"{% endif %}>{{ s.name }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col footer-col--wide">
          <h2>M-Series Chips</h2>
          <ul class="footer-list--inline">
            {% set gens = [] %}
            {% for gen in collections.generationPagesCollection %}
              {% if gen.seriesId == "M" %}{% set _ = gens.push(gen) %}{% endif %}
            {% endfor %}
            {% for gen in gens %}
              <li><a href="/chips/{{ gen.id | lower }}/"{% if gen.onSale %} class="nav-hl-custom"{% endif %}>{{ gen.id | familyLabel }}</a></li>
            {% endfor %}
          </ul>
          <h2>A-Series Chips</h2>
          <ul class="footer-list--inline">
            {% set gens = [] %}
            {% for gen in collections.generationPagesCollection %}
              {% if gen.seriesId == "A" %}{% set _ = gens.push(gen) %}{% endif %}
            {% endfor %}
            {% for gen in gens %}
              <li><a href="/chips/{{ gen.id | lower }}/"{% if gen.onSale %} class="nav-hl-custom"{% endif %}>{{ gen.id | familyLabel }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </nav>
      <p class="footer-note">
        Apple Silicon Specs — a community reference.
        <a href="https://github.com/eustasy/apple-silicon">Corrections and contributions welcome</a>.
      </p>
    </footer>
    <script src="/assets/search.js"></script>
    <script src="/assets/table-sort.js"></script>
    <script>
      document.querySelectorAll('.nav-dropdown-toggle').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const open = btn.getAttribute('aria-expanded') === 'true';
          document.querySelectorAll('.nav-dropdown-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
          if (!open) btn.setAttribute('aria-expanded', 'true');
        });
      });
      document.addEventListener('click', () => {
        document.querySelectorAll('.nav-dropdown-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
      });
    </script>
  </body>
</html>
