<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}{% if title %} — {% endif %}Apple Silicon Specs</title>
    {% if description %}
      <meta name="description" content="{{ description }}" />
    {% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {# Open Graph #}
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title if title else site.name }}" />
    <meta property="og:description" content="{{ description if description else site.description }}" />
    <meta property="og:type" content="{{ ogType if ogType else 'website' }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />

    {# Twitter card #}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ title if title else site.name }}" />
    <meta name="twitter:description" content="{{ description if description else site.description }}" />

    {% block jsonld %}{% endblock %}
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="nav-home">Apple Silicon Specs</a>
        <ul class="nav-links">
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Compare <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-2col">
              <a href="/compare/custom/" class="nav-show-narrow">Custom</a>
              <a href="/compare/video-editing/">Video Editing</a>
              <a href="/compare/ml-ai/">ML/AI</a>
              <a href="/compare/gaming/">Gaming</a>
            </div>
          </li>
          <li class="nav-collapse"><a href="/compare/custom/">Custom</a></li>
          <li class="nav-collapse"><a href="/compare/video-editing/">Video Editing</a></li>
          <li class="nav-collapse"><a href="/compare/ml-ai/">ML/AI</a></li>
          <li class="nav-collapse"><a href="/compare/gaming/">Gaming</a></li>
          <li class="nav-divider" aria-hidden="true"></li>
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Devices <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-3col">
              <a href="/devices/mac/" class="nav-show-narrow">Mac</a>
              <a href="/devices/ipad/" class="nav-show-narrow">iPad</a>
              <a href="/devices/iphone/" class="nav-show-narrow">iPhone</a>
              <a href="/devices/watch/">Apple Watch</a>
              <a href="/devices/airpods/">AirPods</a>
              <a href="/devices/homepod/">HomePod</a>
              <a href="/devices/apple-tv/">Apple TV</a>
              <a href="/devices/vision/">Apple Vision</a>
            </div>
          </li>
          <li class="nav-collapse"><a href="/devices/mac/">Mac</a></li>
          <li class="nav-collapse"><a href="/devices/ipad/">iPad</a></li>
          <li class="nav-collapse"><a href="/devices/iphone/">iPhone</a></li>
          <li class="nav-divider" aria-hidden="true"></li>
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Series <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-2col">
              <a href="/series/m/" class="nav-show-narrow">M Series</a>
              <a href="/series/a/" class="nav-show-narrow">A Series</a>
              <a href="/series/s/">S Series</a>
              <a href="/series/r/">R Series</a>
              <a href="/series/h/">H Series</a>
              <a href="/series/n/">N Series</a>
              <a href="/series/w/">W Series</a>
              <a href="/series/u/">U Series</a>
              <a href="/series/c/">C Series</a>
              <a href="/series/t/">T Series</a>
            </div>
          </li>
          <li class="nav-collapse"><a href="/series/m/">M Series</a></li>
          <li class="nav-collapse"><a href="/series/a/">A Series</a></li>
        </ul>
        <div class="search-wrapper">
          <input type="search" id="site-search" placeholder="Search chips & devices…  /" autocomplete="off" />
          <div id="search-results" class="search-results"></div>
        </div>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <p>Apple Silicon Specs — a community reference.</p>
    </footer>
    <script src="/assets/search.js"></script>
    <script src="/assets/table-sort.js"></script>
    <script>
      document.querySelectorAll('.nav-dropdown-toggle').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const open = btn.getAttribute('aria-expanded') === 'true';
          document.querySelectorAll('.nav-dropdown-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
          if (!open) btn.setAttribute('aria-expanded', 'true');
        });
      });
      document.addEventListener('click', () => {
        document.querySelectorAll('.nav-dropdown-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
      });
    </script>
  </body>
</html>
