<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}{% if title %} — {% endif %}Apple Silicon Specs</title>
    {% if description %}
      <meta name="description" content="{{ description }}" />
    {% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {# Open Graph #}
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title if title else site.name }}" />
    <meta property="og:description" content="{{ description if description else site.description }}" />
    <meta property="og:type" content="{{ ogType if ogType else 'website' }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />

    {# Twitter card #}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ title if title else site.name }}" />
    <meta name="twitter:description" content="{{ description if description else site.description }}" />

    {% block jsonld %}{% endblock %}
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="nav-home">Apple Silicon Specs</a>
        <ul class="nav-links">
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Compare <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-2col">
              <a href="/compare/custom/">Custom</a>
              <a href="/compare/video-editing/">Video Editing</a>
              <a href="/compare/ml-ai/">ML/AI</a>
              <a href="/compare/gaming/">Gaming</a>
            </div>
          </li>
          <li class="nav-collapse"><a href="/compare/custom/" class="nav-hl-custom">Custom</a></li>
          <li class="nav-collapse"><a href="/compare/video-editing/" class="nav-hl-video">Video Editing</a></li>
          <li class="nav-collapse"><a href="/compare/ml-ai/" class="nav-hl-mlai">ML/AI</a></li>
          <li class="nav-collapse"><a href="/compare/gaming/" class="nav-hl-gaming">Gaming</a></li>
          <li class="nav-divider" aria-hidden="true"></li>
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Devices <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-3col">
              <a href="/devices/mac/" class="nav-show-narrow">Mac</a>
              <a href="/devices/ipad/" class="nav-show-narrow">iPad</a>
              <a href="/devices/iphone/" class="nav-show-narrow">iPhone</a>
              <a href="/devices/watch/">Apple Watch</a>
              <a href="/devices/airpods/">AirPods</a>
              <a href="/devices/homepod/">HomePod</a>
              <a href="/devices/apple-tv/">Apple TV</a>
              <a href="/devices/vision/">Apple Vision</a>
              <a href="/devices/display/">Studio Display</a>
            </div>
          </li>
          <li class="nav-dropdown nav-collapse">
            <button class="nav-dropdown-toggle" aria-expanded="false">Mac <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-2col">
              <a href="/devices/mac/" class="nav-dropdown-all">All Macs</a>
              {% for category in devices %}
                {% if category.id == "mac" %}
                  {% for device in category.devices %}
                    {% if not device.deprecated %}
                      <a href="/devices/mac/{{ device.id }}/">{{ device.name }}</a>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            </div>
          </li>
          <li class="nav-dropdown nav-collapse">
            <button class="nav-dropdown-toggle" aria-expanded="false">iPad <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel">
              <a href="/devices/ipad/" class="nav-dropdown-all">All iPads</a>
              <a href="/devices/ipad/pro/13/">iPad Pro 13"</a>
              <a href="/devices/ipad/pro/11/">iPad Pro 11"</a>
              <a href="/devices/ipad/air/13/">iPad Air 13"</a>
              <a href="/devices/ipad/air/10/">iPad Air 10.9"</a>
              <a href="/devices/ipad/base/a16/">iPad</a>
              <a href="/devices/ipad/mini/7/">iPad mini</a>
            </div>
          </li>
          <li class="nav-dropdown nav-collapse">
            <button class="nav-dropdown-toggle" aria-expanded="false">iPhone <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel">
              <a href="/devices/iphone/" class="nav-dropdown-all">All iPhones</a>
              <a href="/devices/iphone/17/pro-max/">iPhone 17 Pro Max</a>
              <a href="/devices/iphone/17/pro/">iPhone 17 Pro</a>
              <a href="/devices/iphone/17/air/">iPhone 17 Air</a>
              <a href="/devices/iphone/17/base/">iPhone 17</a>
              <a href="/devices/iphone/17/e/">iPhone 17e</a>
              <a href="/devices/iphone/16/plus/">iPhone 16 Plus</a>
              <a href="/devices/iphone/16/base/">iPhone 16</a>
            </div>
          </li>
          <li class="nav-divider" aria-hidden="true"></li>
          <li class="nav-dropdown">
            <button class="nav-dropdown-toggle" aria-expanded="false">Series <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-dropdown-panel nav-dropdown-2col">
              <a href="/series/m/" class="nav-show-narrow">M Series</a>
              <a href="/series/a/" class="nav-show-narrow">A Series</a>
              <a href="/series/s/">S Series</a>
              <a href="/series/r/">R Series</a>
              <a href="/series/h/">H Series</a>
              <a href="/series/n/">N Series</a>
              <a href="/series/w/">W Series</a>
              <a href="/series/u/">U Series</a>
              <a href="/series/c/">C Series</a>
              <a href="/series/t/">T Series</a>
            </div>
          </li>
          <li class="nav-collapse"><a href="/series/m/">M Series</a></li>
          <li class="nav-collapse"><a href="/series/a/">A Series</a></li>
        </ul>
        <div class="search-wrapper">
          <input type="search" id="site-search" placeholder="Search chips & devices…  /" autocomplete="off" />
          <div id="search-results" class="search-results"></div>
        </div>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <p>
        Apple Silicon Specs — a community reference.
        <a href="https://github.com/lewisgoddard/apple-silicon">Corrections and contributions welcome</a>.
      </p>
    </footer>
    <script src="/assets/search.js"></script>
    <script src="/assets/table-sort.js"></script>
    <script>
      document.querySelectorAll('.nav-dropdown-toggle').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const open = btn.getAttribute('aria-expanded') === 'true';
          document.querySelectorAll('.nav-dropdown-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
          if (!open) btn.setAttribute('aria-expanded', 'true');
        });
      });
      document.addEventListener('click', () => {
        document.querySelectorAll('.nav-dropdown-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));
      });
    </script>
  </body>
</html>
