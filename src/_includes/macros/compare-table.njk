{# _includes/compare-table.njk #}
{% macro compareTable(items, shortHeaders) %}
  <div class="compare-table-wrapper">
  <table class="compare-table">
    <thead>
      <tr>
        <th>Spec</th>
        {% for item in items %}
          <th data-chip-id="{{ item.id }}">{{ item.name }}{% if not shortHeaders and item.specs and item.specs.cpu_cores and item.specs.gpu_cores %}<br><span class="th-variant">{{ item.specs.cpu_cores }}c&nbsp;CPU / {{ item.specs.gpu_cores }}c&nbsp;GPU</span>{% endif %}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {# Devices row — list devices that use each chip #}
      {% set devicesRowHasData = false %}
      {% for item in items %}
        {% if item.devices and item.devices | length > 0 %}
          {% set devicesRowHasData = true %}
        {% endif %}
      {% endfor %}
      {% if devicesRowHasData %}
      <tr>
        <td>Devices</td>
        {% for item in items %}
          <td>
            {% if item.devices and item.devices | length > 0 %}
              {% for device in item.devices %}
                <a href="{{ device.url }}">{{ device.name }}</a>{% if not loop.last %}<br>{% endif %}
              {% endfor %}
            {% else %}
              –
            {% endif %}
          </td>
        {% endfor %}
      </tr>
      {% endif %}
      {# Iterate groups/fields by index — all items share the same structure from specs.yml #}
      {% for group in items[0].groupedSpecs %}
        {% set groupIndex = loop.index0 %}

        {# Check if any item has at least one non-null field in this group #}
        {% set groupHasData = false %}
        {% for field in group.fields %}
          {% set fieldIndex = loop.index0 %}
          {% for item in items %}
            {% set f = item.groupedSpecs[groupIndex].fields[fieldIndex] %}
            {% if f.value is not none and f.value is defined %}
              {% set groupHasData = true %}
            {% endif %}
          {% endfor %}
        {% endfor %}

        {% if groupHasData %}
        <tr class="group-header">
          <td colspan="{{ items | length + 1 }}"><strong>{{ group.name }}</strong></td>
        </tr>

        {% for field in group.fields %}
          {% set fieldIndex = loop.index0 %}
          {# Only show rows where at least one item has a value #}
          {% set rowHasData = false %}
          {% for item in items %}
            {% set f = item.groupedSpecs[groupIndex].fields[fieldIndex] %}
            {% if f.value is not none and f.value is defined %}
              {% set rowHasData = true %}
            {% endif %}
          {% endfor %}
          {% if rowHasData %}
          <tr>
            <td>{{ field.label }}</td>
            {% for item in items %}
              {% set f = item.groupedSpecs[groupIndex].fields[fieldIndex] %}
              <td>
                {% if f.value is none or f.value is not defined %}
                  –
                {% elif f.value is iterable and f.value is not string %}
                  {{ f.value | join("<br>") | safe }}
                {% elif f.value is sameas true %}
                  ✓
                {% elif f.value is sameas false %}
                  ✗
                {% else %}
                  {{ f.value }}
                {% endif %}
              </td>
            {% endfor %}
          </tr>
          {% endif %}
        {% endfor %}
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
  </div>
{% endmacro %}
