{# _includes/macros/device-carousel.njk #}
{% macro deviceCarousel(devices) %}
{% if devices and devices | length > 0 %}
  <h2>Available in</h2>
  <div class="device-carousel">
    {% for device in devices %}
      <a class="device-card" href="{{ device.url }}">
        <span class="device-card-name">{{ device.name }}</span>
        <span class="device-card-category">{{ device.categoryName }}</span>
      </a>
    {% endfor %}
  </div>
{% endif %}
{% endmacro %}
