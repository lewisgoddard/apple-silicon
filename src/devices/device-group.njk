---
layout: base.njk
pagination:
  data: collections.deviceGroupPagesCollection
  size: 1
  alias: group
permalink: "devices/{{ group.categoryId | lower }}/{{ group.id | lower }}/index.html"
eleventyComputed:
  title: "{{ group.name }}"
  description: "Apple Silicon chip comparison for {{ group.name }} models."
---

{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/compare-table.njk" import compareTable %}
{% from "macros/device-grid.njk" import deviceGrid %}

{{ breadcrumbs([
  { label: group.categoryName, url: "/devices/" + (group.categoryId | lower) + "/" },
  { label: group.name }
]) }}

<h1>{{ group.name }}</h1>

{% if group.devices and group.devices | length > 0 %}
  {% set baseUrl = "/devices/" + (group.categoryId | lower) + "/" + (group.id | lower) + "/" %}
  {{ deviceGrid(group.devices, collections, baseUrl) }}

  {% if group.allVariants and group.allVariants | length > 0 %}
    {% set socVariants = group.allVariants | primaryChips %}
    <h2>Chip Comparison</h2>
    {% set items = getChips(socVariants, collections) %}
    {{ compareTable(items) }}
  {% endif %}
{% endif %}
