---
layout: base.njk
pagination:
  data: collections.devicePagesCollection
  size: 1
  alias: device
permalink: "{% if device.groupId %}devices/{{ device.categoryId | lower }}/{{ device.groupId | lower }}/{{ device.id | lower }}/index.html{% else %}devices/{{ device.categoryId | lower }}/{{ device.id | lower }}/index.html{% endif %}"
eleventyComputed:
  title: "{{ device.name }}"
  description: "Apple Silicon chip options for the {{ device.name }}."
  ogType: "product"
---

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ device.name }}",
  "brand": { "@type": "Brand", "name": "Apple" },
  "description": "Apple Silicon chip options for the {{ device.name }}.",
  "url": "{{ site.url }}{% if device.groupId %}/devices/{{ device.categoryId | lower }}/{{ device.groupId | lower }}/{{ device.id | lower }}/{% else %}/devices/{{ device.categoryId | lower }}/{{ device.id | lower }}/{% endif %}",
  "category": "{{ device.categoryName }}"
}
</script>
{% endblock %}

{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/compare-table.njk" import compareTable %}

{% if device.groupId %}
{{ breadcrumbs([
  { label: device.categoryName, url: "/devices/" + (device.categoryId | lower) + "/" },
  { label: device.groupName, url: "/devices/" + (device.categoryId | lower) + "/" + (device.groupId | lower) + "/" },
  { label: device.name }
]) }}
{% else %}
{{ breadcrumbs([
  { label: device.categoryName, url: "/devices/" + (device.categoryId | lower) + "/" },
  { label: device.name }
]) }}
{% endif %}

<h1>{{ device.name }}</h1>

{% if device.variants and device.variants | length > 0 %}
  {% set socVariants = device.variants | primaryChips %}
  <p>{{ socVariants | length }} chip option{{ "s" if socVariants | length != 1 }}
  ({{ getChipRange(socVariants, collections) }})</p>

  {% if device.generationGroups and device.generationGroups | length > 1 %}
    {# Multiple generations — show grouped sections #}
    {% for gen in device.generationGroups %}
      {% set genSocIds = gen.chipIds | primaryChips(device.variants) %}
      {% if genSocIds | length > 0 %}
      <h2>
        {{ gen.label }} Generation
        {% if gen.isCurrent %}<span class="badge-current">Current</span>{% endif %}
      </h2>
      {% set items = getChips(genSocIds, collections) %}
      {{ compareTable(items) }}
      {% endif %}
    {% endfor %}
  {% else %}
    {# Single generation — show flat table #}
    {% set items = getChips(socVariants, collections) %}
    {{ compareTable(items) }}
  {% endif %}

  {% set companionVariants = device.variants | companionChips %}
  {% if companionVariants | length > 0 %}
    <h2>Companion Silicon</h2>
    {% set companionGroups = groupCompanionsBySeries(companionVariants) %}
    {% for cgroup in companionGroups %}
      <h3>{{ cgroup.seriesName }}</h3>
      {% if cgroup.seriesDescription %}<p>{{ cgroup.seriesDescription }}</p>{% endif %}
      {% set companionItems = getChips(cgroup.chipIds, collections) %}
      {{ compareTable(companionItems) }}
    {% endfor %}
  {% endif %}
{% endif %}
