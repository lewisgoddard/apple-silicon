---
layout: base.njk
pagination:
  data: collections.devicePagesCollection
  size: 1
  alias: device
permalink: "devices/{{ device.categoryId | lower }}/{{ device.id | lower }}/index.html"
eleventyComputed:
  title: "{{ device.name }}"
  description: "Apple Silicon chip options for the {{ device.name }}."
  ogType: "product"
---

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ device.name }}",
  "brand": { "@type": "Brand", "name": "Apple" },
  "description": "Apple Silicon chip options for the {{ device.name }}.",
  "url": "{{ site.url }}/devices/{{ device.categoryId | lower }}/{{ device.id | lower }}/",
  "category": "{{ device.categoryName }}"
}
</script>
{% endblock %}

{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/compare-table.njk" import compareTable %}

{{ breadcrumbs([
  { label: device.categoryName, url: "/devices/" + (device.categoryId | lower) + "/" },
  { label: device.name }
]) }}

<h1>{{ device.name }}</h1>

{% if device.variants and device.variants | length > 0 %}
  <p>{{ device.variants | length }} chip option{{ "s" if device.variants | length != 1 }}
  ({{ getChipRange(device.variants, collections) }})</p>

  {% if device.generationGroups and device.generationGroups | length > 1 %}
    {# Multiple generations — show grouped sections #}
    {% for gen in device.generationGroups %}
      <h2>
        {{ gen.label }} Generation
        {% if gen.isCurrent %}<span class="badge-current">Current</span>{% endif %}
      </h2>
      {% set items = getChips(gen.chipIds, collections) %}
      {{ compareTable(items) }}
    {% endfor %}
  {% else %}
    {# Single generation — show flat table #}
    {% set items = getChips(device.variants, collections) %}
    {{ compareTable(items) }}
  {% endif %}
{% endif %}
