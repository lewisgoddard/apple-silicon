---
layout: base.njk
pagination:
  data: collections.rankPagesCollection
  size: 1
  alias: rank
permalink: "chips/{{ rank.id | genId | lower }}/{{ rank.id | tierSlug | lower }}/index.html"
eleventyComputed:
  title: "{{ rank.name }}{% if rank.variants | length > 1 %} Variants{% endif %}"
  description: "{% if rank.variants | length > 1 %}Compare all {{ rank.name }} chip variants.{% else %}{{ rank.description }}{% endif %}"
---

{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/gen-nav.njk" import genNav %}

{{ breadcrumbs([
  { label: rank.seriesName, url: "/series/" + (rank.seriesId | lower) + "/" },
  { label: (rank.id | familyLabel) + " Family", url: "/chips/" + (rank.id | genId | lower) + "/" },
  { label: rank.name }
]) }}

<h1>{{ rank.name }}</h1>

{{ genNav(rank.prevGenTier, rank.nextGenTier, rank.siblingTiers) }}

{% if rank.description %}
  <p>{{ rank.description }}</p>
{% endif %}

{% from "macros/compare-table.njk" import compareTable %}
{% from "macros/device-carousel.njk" import deviceCarousel %}

{% if rank.variants and rank.variants | length > 0 %}
  {# A single-variant rank is that chip's own page, so the count adds nothing #}
  {% if rank.variants | length > 1 %}
    <p>{{ rank.variants | length }} variants</p>
  {% endif %}
  {% set items = getChips(rank.variants, collections) %}
  {{ compareTable(items) }}

  {% set devices = getDevicesForChips(rank.variants) %}
  {{ deviceCarousel(devices) }}
{% endif %}
