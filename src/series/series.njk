---
layout: base.njk
pagination:
  data: collections.seriesCollection
  size: 1
  alias: seriesItem
permalink: "series/{{ seriesItem.id | lower }}/index.html"
eleventyComputed:
  title: "{{ seriesItem.name }}"
  description: "{{ seriesItem.description }}"
---

<h1>{{ seriesItem.name }}</h1>
<p>{{ seriesItem.description }}</p>

{% if seriesItem.ranks %}
  {% set currentGen = "" %}
  <ul>
    {% for rank in seriesItem.ranks %}
      {% if rank.name %}
        {% set thisGen = rank.id | genId %}
        {% if thisGen != currentGen %}
          {% if currentGen != "" %}
            </ul></li>
          {% endif %}
          {% set currentGen = thisGen %}
          <li>
            <a href="/chips/{{ thisGen | lower }}/">
              <strong>{{ rank.name | replace(" Ultra", "") | replace(" Max", "") | replace(" Pro", "") }} Family</strong>
            </a>
            <ul>
        {% endif %}
        <li>
          {% if rank.variants and rank.variants | length > 0 %}
            <a href="/chips/{{ rank.id | genId | lower }}/{{ rank.id | tierSlug | lower }}/">
              <strong>{{ rank.name }}</strong>
            </a>
            — {{ rank.variants | length }} variant{{ "s" if rank.variants | length != 1 }}
          {% else %}
            <strong>{{ rank.name }}</strong>
          {% endif %}
          {% if rank.description %}
            <br>{{ rank.description }}
          {% endif %}
        </li>
      {% endif %}
    {% endfor %}
    {% if currentGen != "" %}
      </ul></li>
    {% endif %}
  </ul>
{% endif %}