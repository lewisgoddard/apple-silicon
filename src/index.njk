<h1>Apple Silicon Specs</h1>
<p>
  A community reference for the technical specifications of every Apple Silicon
  chip — from the M1 to the latest generation.
</p>

<h2>Browse by Series</h2>
<ul>
  {% for seriesItem in collections.seriesCollection %}
    <li>
      <a href="/series/{{ seriesItem.id | lower }}/">
        <strong>{{ seriesItem.name }}</strong>
      </a>
      — {{ seriesItem.description }}
    </li>
  {% endfor %}
</ul>

<h2>Browse by Device</h2>
<ul>
  {% for category in collections.devicesCollection %}
    <li>
      <a href="/devices/{{ category.id | lower }}/">
        <strong>{{ category.name }}</strong>
      </a>
      — {{ category.description }}
    </li>
  {% endfor %}
</ul>

